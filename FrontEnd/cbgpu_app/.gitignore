# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Supabase CLI local cache
supabase/.temp/

# Firebase service account keys should never sit in the repo — stored as a Supabase secret instead
*firebase-adminsdk*.json
/google-services.json

# Play Store release signing key — losing this from git history is fine (it
# never should have been there); losing the actual file without a backup
# means never being able to publish an update under this app listing again.
*.jks
*.keystore
key.properties

# Signed distributables belong in Releases, not the source tree.
/store/*.apk
