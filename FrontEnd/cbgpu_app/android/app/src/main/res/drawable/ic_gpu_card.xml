<?xml version="1.0" encoding="utf-8"?>
<!-- No real GPU product photo exists in this repo (only the 3D printer has
     one) — a plain flat graphics-card icon instead of grabbing an arbitrary
     stock photo of hardware that may not even match what CBGPU actually
     runs. Solid white fill so it can be recolored per-status at runtime via
     RemoteViews setColorFilter (see GpuStatusWidgetProvider). -->
