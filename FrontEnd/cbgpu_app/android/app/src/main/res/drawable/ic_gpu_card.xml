    <path
        android:pathData="M2,7 L20,7 C21.1,7 22,7.9 22,9 L22,15 C22,16.1 21.1,17 20,17 L2,17 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- I/O bracket -->
    <path
        android:pathData="M2,9 L0.5,9 C0.22,9 0,9.22 0,9.5 L0,14.5 C0,14.78 0.22,15 0.5,15 L2,15 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- fans -->
    <path
        android:pathData="M8,12 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4" />
